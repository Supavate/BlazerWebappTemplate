@page "/error"
@page "/error/{StatusCode:int}"
@using System.Diagnostics
@attribute [AllowAnonymous]
@layout MainLayout
@inject IJSRuntime JSRuntime

<PageTitle>@Title</PageTitle>

<section class="portal-page compact-page">
    <header class="portal-page-header">
        <div class="portal-page-header-copy">
            <span class="eyebrow">Error @ResolvedStatusCode</span>
            <h1 class="portal-page-title">@Title</h1>
            <p class="portal-page-subtitle">@Message</p>
        </div>
    </header>

    @if (ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
    }

    <div class="d-flex gap-2">
        <MudButton OnClick="GoBackAsync"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Go back
        </MudButton>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">
            Return home
        </MudButton>
    </div>
</section>

@code {
    [Parameter]
    public int? StatusCode { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private int ResolvedStatusCode { get; set; } = StatusCodes.Status500InternalServerError;
    private string Title { get; set; } = "Something went wrong";
    private string Message { get; set; } = "An unexpected error occurred while processing your request.";

    private async Task GoBackAsync() =>
        await JSRuntime.InvokeVoidAsync("history.back");

    protected override void OnParametersSet()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        ResolvedStatusCode = StatusCode
            ?? HttpContext?.Response.StatusCode
            ?? StatusCodes.Status500InternalServerError;

        (Title, Message) = ResolvedStatusCode switch
        {
            StatusCodes.Status400BadRequest =>
                ("Bad request", "The request could not be understood or was invalid."),
            StatusCodes.Status401Unauthorized =>
                ("Sign-in required", "Please sign in to access this resource."),
            StatusCodes.Status403Forbidden =>
                ("Access denied", "You do not have permission to access this resource."),
            StatusCodes.Status404NotFound =>
                ("Page not found", "The page or resource you requested does not exist."),
            StatusCodes.Status405MethodNotAllowed =>
                ("Method not allowed", "This resource does not support the requested action."),
            StatusCodes.Status408RequestTimeout =>
                ("Request timed out", "The request took too long to complete."),
            StatusCodes.Status429TooManyRequests =>
                ("Too many requests", "Please wait a moment and try again."),
            StatusCodes.Status503ServiceUnavailable =>
                ("Service unavailable", "The service is temporarily unavailable. Please try again later."),
            _ when ResolvedStatusCode >= 500 =>
                ("Something went wrong", "An unexpected error occurred while processing your request."),
            _ =>
                ("Request failed", $"The request could not be completed (HTTP {ResolvedStatusCode}).")
        };
    }
}
