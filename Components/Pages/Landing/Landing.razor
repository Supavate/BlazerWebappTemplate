@page "/"
@page "/landing"
@inject NavigationMerger NavigationMerger
@inject NavigationAuthorizationService NavigationAuthorization
@inject NavigationManager Navigation

@code {
    protected override async Task OnInitializedAsync()
    {
        var items = await NavigationMerger.GetItemsAsync();
        var authorizedItems = await NavigationAuthorization.GetAuthorizedItemsAsync(items);
        var destination = NavigationLandingSelector.GetDestination(authorizedItems);

        Navigation.NavigateTo(NavigationRouteHelper.ToBaseRelativeHref(destination), replace: true);
    }
}

