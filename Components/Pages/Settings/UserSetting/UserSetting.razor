@page "/settings/users"
@attribute [NavMenu("Users", Icons.Material.Filled.People, Parent = "/settings", Order = 10)]

<PageTitle>Users · SiS Workspace</PageTitle>

<section class="portal-page">
    <header class="portal-page-header">
        <div class="portal-page-header-copy">
            <p class="portal-eyebrow">Settings / Users</p>
            <h1 class="portal-page-title">User settings</h1>
            <p class="portal-page-subtitle">Review the Microsoft Entra ID integration and future application-role setup.</p>
        </div>
        <span class="status-chip success">SSO enabled</span>
    </header>

    <section class="table-shell">
        <div class="portal-card-header table-heading">
            <div>
                <h2 class="portal-card-title">Identity capabilities</h2>
                <p class="portal-card-subtitle">Authentication is supplied by Microsoft Entra ID.</p>
            </div>
            <span class="status-chip info">Planned</span>
        </div>
        <div class="table-scroll">
            <table class="portal-table">
                <thead><tr><th>Feature</th><th>Purpose</th><th>Provider</th><th>Status</th></tr></thead>
                <tbody>
                    <tr><td><strong>Single sign-on</strong></td><td>Authenticate organizational users</td><td>Microsoft Entra ID</td><td><span class="status-chip success">Enabled</span></td></tr>
                    <tr><td><strong>Application roles</strong></td><td>Authorize administrative and standard-user features</td><td>Microsoft Entra ID</td><td><span class="status-chip warning">Not configured</span></td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="portal-alert development-warning">
        <strong>Application roles</strong>
        <span>Define and assign Entra application roles before enabling role-specific pages or navigation.</span>
    </div>
</section>
