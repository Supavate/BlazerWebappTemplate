@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationMerger NavigationMerger
@inject NavigationAuthorizationService NavigationAuthorization
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.Extensions.Options.IOptions<MyWebApp.Configurations.ApplicationOptions> ApplicationOptions

<MudThemeProvider Theme="@AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-shell">
    <MudDrawer Variant="@DrawerVariant.Mini"
               @bind-Open="_drawerOpen"
               OpenMiniOnHover="true"
               Width="280px"
               MiniWidth="76px"
               Elevation="0"
               Class="portal-sidebar">
        <div class="sidebar-content">
            <div class="sidebar-brand" aria-label="@ApplicationOptions.Value.Name">
                <span class="brand-icon">
                    <MudIcon Icon="@BrandIconResolver.Resolve(ApplicationOptions.Value.Icon)" />
                </span>
                <span class="sidebar-expanded-content brand-name">@ApplicationOptions.Value.Name</span>
            </div>

            <div class="sidebar-divider" role="presentation"></div>

            <MudNavMenu Class="sidebar-navigation">
                @foreach (var item in _navigationItems)
                {
                    <NavTreeItem Item="item" />
                }
            </MudNavMenu>

            <AuthenticationControls />
        </div>
    </MudDrawer>

    <MudMainContent Class="portal-main-content">
        <LoggingErrorBoundary>
            <ChildContent>
                <main class="main-content" id="main-content">
                    @Body
                </main>
            </ChildContent>
            <ErrorContent Context="error">
                <section class="portal-page compact-page">
                    <div class="portal-alert danger">
                        <strong>Something went wrong.</strong>
                        <span>Please reload the page. Technical details were not displayed.</span>
                    </div>
                </section>
            </ErrorContent>
        </LoggingErrorBoundary>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    The connection was interrupted.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool _drawerOpen;
    private IReadOnlyList<NavItem> _navigationItems = [];

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        await RefreshNavigationAsync();
    }

    private async Task RefreshNavigationAsync()
    {
        var items = await NavigationMerger.GetItemsAsync();
        _navigationItems = await NavigationAuthorization
            .GetAuthorizedItemsAsync(items);
    }

    private void HandleAuthenticationStateChanged(
        Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshNavigationAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }
}
