@inject NavigationManager Navigation
@inject MyWebApp.Application.Abstractions.Authentication.ICurrentUserService CurrentUserService
@inject ILogger<AuthenticationControls> Logger

<div class="sidebar-account">
    <AuthorizeView Context="authenticationState">
        <Authorized>
            <div class="account-summary">
                <MudAvatar Color="@Color.Tertiary" Size="@Size.Medium">
                    @GetInitials(authenticationState.User.Identity?.Name)
                </MudAvatar>
                <div class="sidebar-expanded-content account-copy">
                    <strong>@(_currentUser?.DisplayName ?? authenticationState.User.Identity?.Name)</strong>
                    <span>@(_currentUser?.Email ?? GetEmail(authenticationState.User))</span>
                    <small>@(_currentUser?.JobTitle ?? GetRole(authenticationState.User))</small>
                </div>
            </div>
            <MudButton Variant="@Variant.Text"
                       Color="@Color.Inherit"
                       StartIcon="@Icons.Material.Filled.Logout"
                       FullWidth="true"
                       OnClick="SignOut"
                       Class="sidebar-account-button">
                <span class="sidebar-expanded-content">Sign out</span>
            </MudButton>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private MyWebApp.Application.Models.Authentication.CurrentUser? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentUser = await CurrentUserService.GetCurrentUserAsync();
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not load the current user's Microsoft Graph profile.");
        }
    }

    private void SignOut() =>
        Navigation.NavigateTo("/MicrosoftIdentity/Account/SignOut", forceLoad: true);

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "DU";
        }

        return string.Concat(name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    }

    private static string GetEmail(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("preferred_username")?.Value
        ?? user.FindFirst("upn")?.Value
        ?? user.FindFirst("email")?.Value
        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? "No email";

    private static string GetRole(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
}
